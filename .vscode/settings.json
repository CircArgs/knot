{
    // Open *.marimo.py files with the marimo VS Code extension's
    // notebook editor. The extension (`marimo-team.vscode-marimo`)
    // contributes a notebook type with `priority: "option"`, meaning
    // it normally requires the user to pick "Open with > marimo
    // Notebook" — this association overrides that and forces marimo
    // as the default for the *.marimo.py pattern. Plain *.py files
    // continue to open in the regular text editor.
    "workbench.editorAssociations": {
        "*.marimo.py": "marimo-notebook"
    },
    // Keep type checking + linting working on the notebook sources.
    // marimo files are still valid Python modules.
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    }
}
